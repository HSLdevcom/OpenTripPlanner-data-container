  "updaters": [
    {
      "type": "vehicle-positions",
      "url": "https://mobility-api.mobility-database.fintraffic.fi/gtfs-realtime/v2",
      "feedId": "MATKA",
      "frequency": "30s",
      "fuzzyTripMatching": true,
      "headers": {
        "x-api-key": "${MOBILITY_API_KEY}"
      },
      "features": ["stop-position", "occupancy"]
    },
    {
      "id": "matka-trip-updates",
