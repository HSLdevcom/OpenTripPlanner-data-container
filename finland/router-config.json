      "minWindow": "3h"
    },
    "transferCacheRequests": [
      {
        "modes": "WALK"
      },
      {
        "modes": "WALK",
        "wheelchairAccessibility": {
          "enabled": true
        }
      },
      {
        "modes": "WALK",
